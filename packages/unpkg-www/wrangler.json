{
  "compatibility_date": "2024-12-05",
  "main": "./src/worker.ts",
  "assets": { "directory": "./public" },
  "build": { "command": "pnpm run build:assets" },
  "placement": {
    "mode": "smart"
  },
  "name": "unpkg",
  "observability": { "enabled": true, "head_sampling_rate": 0.001 },
  "routes": [{ "pattern": "cdn.c23.me/*", "zone_name": "c23.me" }],
  "vars": {
    "APP_ORIGIN": "https://app.unpkg.com",
    "ASSETS_ORIGIN": "https://cdn.c23.me",
    "DEV": false,
    "ESM_ORIGIN": "https://esm.cdn.c23.me",
    "FILES_ORIGIN": "https://fly.unpkg.com",
    "MODE": "production",
    "ORIGIN": "https://cdn.c23.me"
  },

  "env": {
    "dev": {
      "name": "unpkg-www-dev",
      "routes": [],
      "vars": {
        "APP_ORIGIN": "http://localhost:3001",
        "ASSETS_ORIGIN": "http://localhost:8000",
        "DEV": true,
        "ESM_ORIGIN": "http://localhost:3002",
        "FILES_ORIGIN": "http://localhost:4000",
        "MODE": "development",
        "ORIGIN": "http://localhost:3000"
      }
    }
  },

  "staging": {
    "name": "unpkg-www-staging",
    "observability": { "enabled": true },
    "routes": [
      { "pattern": "www.unpkg.dev", "custom_domain": true },
      { "pattern": "unpkg.dev", "custom_domain": true }
    ],
    "vars": {
      "APP_ORIGIN": "https://app.unpkg.dev",
      "ASSETS_ORIGIN": "https://unpkg.dev",
      "DEV": false,
      "ESM_ORIGIN": "https://esm.unpkg.dev",
      "FILES_ORIGIN": "https://fly.unpkg.dev",
      "MODE": "staging",
      "ORIGIN": "https://unpkg.dev"
    }
  }
}
