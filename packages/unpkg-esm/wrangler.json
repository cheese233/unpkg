{
  "compatibility_date": "2024-12-05",
  "main": "./src/worker.ts",
  "assets": { "directory": "./public" },
  "placement": {
    "mode": "smart"
  },
  "name": "unpkg-esm",
  "observability": { "enabled": true, "head_sampling_rate": 0.001 },
  "routes": [{ "pattern": "esm.cdn.c23.me/*", "zone_name": "c23.me" }],
  "vars": {
    "FILES_ORIGIN": "https://fly.unpkg.com",
    "MODE": "production",
    "ORIGIN": "https://esm.cdn.c23.me",
    "WWW_ORIGIN": "https://cdn.c23.me"
  },

  "env": {
    "dev": {
      "name": "unpkg-esm-dev",
      "routes": [],
      "vars": {
        "FILES_ORIGIN": "http://localhost:4000",
        "MODE": "development",
        "ORIGIN": "http://localhost:3002",
        "WWW_ORIGIN": "http://localhost:3000"
      }
    },

    "staging": {
      "name": "unpkg-esm-staging",
      "observability": { "enabled": true },
      "workers_dev": true,
      "routes": [{ "pattern": "esm.unpkg.dev", "custom_domain": true }],
      "vars": {
        "FILES_ORIGIN": "https://fly.unpkg.dev",
        "MODE": "staging",
        "ORIGIN": "https://esm.unpkg.dev",
        "WWW_ORIGIN": "https://unpkg.dev"
      }
    }
  }
}
